    },
    {
      "id": "047535F9D3AD479D",
      "title": "Advanced Engineering",
      "x": -4,
      "y": 20,
      "icon": "minecraft:map",
      "optional": true,
      "description": [
        "Automate work that you repeat. Storage networks, manufacturing, resource crops and settlements are parallel investments, not a checklist every player must finish.",
        "This row suggests a direction, not a requirement to finish every mod. Linked icons open the original quests and share their progress and rewards. Use /journey for a current recommendation."
      ],
      "tasks": [
