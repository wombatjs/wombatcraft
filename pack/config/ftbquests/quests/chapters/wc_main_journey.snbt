    {
      "id": "789364E721F1C2F4",
      "title": "Beyond the Stars",
      "x": -4,
      "y": 25,
      "icon": "minecraft:map",
      "optional": true,
      "description": [
        "Build fuel and oxygen infrastructure before launching. Planetary materials unlock Stellar Cores, Astralium and renewable late-game production.",
        "This row suggests a direction, not a requirement to finish every mod. Linked icons open the original quests and share their progress and rewards. Use /journey for a current recommendation."
      ],
