  "quests": [
    {
      "id": "11A063033D7F0CAE",
      "title": "The Journey Begins",
      "x": -4,
      "y": 0,
      "icon": "minecraft:map",
      "optional": true,
      "description": [
        "Build a safe base, learn recipes and protect your supplies. These foundations support every path.",
        "This row suggests a direction, not a requirement to finish every mod. Linked icons open the original quests and share their progress and rewards. Use /journey for a current recommendation."
      ],
      "tasks": [
        {
          "id": "7C3FA988771A358B",
          "type": "checkmark",
          "title": "Read this route"
        }
      ],
      "rewards": []
    },
    {
      "id": "65DE0249563FC76F",
      "title": "The Industrial Age",
      "x": -4,
      "y": 5,
      "icon": "minecraft:map",
      "optional": true,
      "description": [
        "Choose a power route and begin processing materials. Mechanical power, FE machines and Convergence research are complementary options.",
        "This row suggests a direction, not a requirement to finish every mod. Linked icons open the original quests and share their progress and rewards. Use /journey for a current recommendation."
      ],
      "tasks": [
        {
          "id": "22CF583CB21C6DD5",
