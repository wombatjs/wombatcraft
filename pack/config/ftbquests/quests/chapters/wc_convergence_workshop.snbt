    },
    {
      "id": "0A1373D1F7D9214E",
      "title": "Time becomes a consumable",
      "icon": "kubejs:stabilized_flux",
      "x": 0,
      "y": 8,
      "description": [
        "Combine Temporal and Stellar Cores with ender pearls for eight flux. Flux enables accelerated batches and keeps the space and dimension specialists useful after initial exploration."
      ],
      "dependencies": [
