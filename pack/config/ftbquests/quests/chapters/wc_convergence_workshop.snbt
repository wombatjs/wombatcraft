    {
      "id": "1A3F0A3B5600F9E3",
      "title": "Carry an expedition field",
      "icon": "wombatcraft_smp:field_projector",
      "x": 4,
      "y": 4,
      "description": [
        "Right-click with a Field Charge in your inventory for three minutes of water breathing and night vision. Each use spends one charge. The ten-second cooldown prevents repeated activation. It does not supply space oxygen, flight or combat invulnerability."
      ],
      "dependencies": [
        "6FA654F9522AD877"
      ],
