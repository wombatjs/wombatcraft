        }
      ],
      "rewards": []
    },
    {
      "id": "6FA654F9522AD877",
      "title": "Arcane Infuser",
      "icon": "wombatcraft:arcane_infuser",
      "x": 12,
      "y": 0,
      "description": [
        "After your first Aetherium batch, build an Infuser. Use the same wall pattern with manasteel block frames and amethyst block caps. This station makes catalysts, Living Relics, farmland, mana metals, storage crystals and expedition supplies. Both FE and mana are required."
      ],
      "dependencies": [
        "6FD1199C48023A5D"
      ],
      "tasks": [
        {
          "id": "6A4659F6AEC4C0AA",
          "type": "item",
