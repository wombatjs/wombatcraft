    {
      "id": "6235951CCD6B57FE",
      "title": "Dimensional Stabilizer",
      "icon": "wombatcraft:dimensional_stabilizer",
      "x": 12,
      "y": 4,
      "description": [
        "Craft this controller after reaching Astralium. Build its wall with ostrum block frames and crying obsidian caps. It handles renewable Ancient and Temporal Cores, planetary metals and travel equipment. Existing TARDIS travel is welcome but no ship ownership or ship parts are consumed."
      ],
      "dependencies": [
        "6FA654F9522AD877"
