  "components": [
    {
      "name": "Play",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "HTML approximation of Qt Play states. Object-specific Qt borders override generic focus; browser focus is native.",
      "html": "<button class=\"ds-play\">Play Wombatcraft</button>",
      "css": ".ds-play{font:15px \"Segoe UI\",sans-serif;color:#f5efff;border:1px solid #59436e;border-radius:8px;padding:11px 16px;text-align:left;background:#783ee3;border-color:#af7cff;font-size:25px;font-weight:700;padding:17px 24px}.ds-play:hover{background:#8c51ee}.ds-play:focus-visible{border:1px solid #af7cff}.ds-play:disabled{background:#49325f;color:#baa5cf;border-color:#674d7e}"
    },
    {
      "name": "Secondary action",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Supporting native Qt action translated for preview.",
      "html": "<button class=\"ds-action\">Explore the pack</button>",
      "css": ".ds-action{font:15px \"Segoe UI\",sans-serif;color:#f5efff;border:1px solid #59436e;border-radius:8px;padding:11px 16px;text-align:left;background:#30243f}.ds-action:hover{background:#45305e;border-color:#b58aed}.ds-action:focus-visible{outline:none;border:2px solid #d9baff}.ds-action:disabled{background:#30243f;color:#b7a5c8;border-color:#4c3c5d}"
    },
    {
      "name": "Sidebar navigation",
      "kind": "nav",
      "refersTo": "navigation",
      "description": "One selected stacked page; hover overrides selected fill. Browser preview uses native focus.",
      "html": "<nav class=\"ds-nav\"><button aria-current=\"page\">Home</button><button>Your pack</button><button>Account</button><button>Settings</button><button>About</button></nav>",
      "css": ".ds-nav{background:#21192d;padding:16px;width:172px;display:grid;gap:9px}.ds-nav button{font:15px \"Segoe UI\",sans-serif;color:#f5efff;border:1px solid #59436e;border-radius:8px;padding:11px 16px;text-align:left;background:transparent;border-color:transparent;padding:14px 16px}.ds-nav button[aria-current]{background:#4e2d78;border-color:#8051b0;font-weight:600}.ds-nav button:hover{background:#352545}.ds-nav button:focus-visible{outline:auto}"
    },
    {
      "name": "Content surface",
      "kind": "card",
      "refersTo": "surface",
      "description": "Plum card with tonal border; no hover motion or elevation.",
      "html": "<section class=\"ds-card\"><h2>A world worth making yours</h2><p>Raise a workshop. Learn forgotten magic. Build a home together.</p></section>",
      "css": ".ds-card{background:#261e32;border:1px solid #392e47;border-radius:12px;padding:20px 22px;color:#f5efff;font:15px \"Segoe UI\",sans-serif}.ds-card h2{font-size:22px;font-weight:600;margin:0 0 12px}.ds-card p{margin:0}"
    },
    {
      "name": "Memory input",
      "kind": "input",
      "refersTo": "memory-input",
      "description": "Native spin box approximation; 6\u201316 GB, persisted value, default 10. Browser supplies native focus and arrows.",
      "html": "<label class=\"ds-memory\">Minecraft memory <input type=\"number\" min=\"6\" max=\"16\" value=\"10\" aria-label=\"Memory in GB\"> GB</label>",
      "css": ".ds-memory{font:15px \"Segoe UI\",sans-serif;color:#f5efff}.ds-memory input{font:15px \"Segoe UI\",sans-serif;color:#f5efff;background:#21182d;border:1px solid #79579b;border-radius:6px;padding:9px;width:65px}"
    },
    {
      "name": "Progress",
      "kind": "custom",
      "refersTo": "progress",
      "description": "Completed state; runtime is native indeterminate during work, not a percentage.",
      "html": "<div class=\"ds-progress\" role=\"progressbar\" aria-label=\"Installation complete\" aria-valuenow=\"1\" aria-valuemin=\"0\" aria-valuemax=\"1\"><span></span></div>",
      "css": ".ds-progress{background:#362947;border-radius:2px;height:5px;width:100%}.ds-progress span{display:block;height:5px;background:#b27bff;border-radius:2px}"
    }
