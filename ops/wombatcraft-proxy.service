[Unit]
Description=Wombatcraft low-latency TCP proxy over WireGuard
After=network-online.target fivem-wg.service
Wants=network-online.target

[Service]
ExecStartPre=/usr/sbin/haproxy -c -f /etc/wombatcraft/proxy.cfg
ExecStart=/usr/sbin/haproxy -W -db -f /etc/wombatcraft/proxy.cfg
ExecReload=/bin/kill -USR2 $MAINPID
Restart=on-failure
RestartSec=3
DynamicUser=yes
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
Nice=-5
CPUWeight=1000

[Install]
WantedBy=multi-user.target
